{
  "manifest_version": 3,
  "name": "HF Custom Sort",
  "version": "1.0.0",
  "description": "Estimate Hugging Face models for your GPU: VRAM fit, formats, compatibility",
  "permissions": ["storage"],
  "host_permissions": ["https://huggingface.co/*"],
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-48x48.png",
    "128": "icons/icon-128x128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://huggingface.co/models*"],
      "js": [
        "data/gpu.js",
        "data/glossary.js",
        "data/benchmarks.js",
        "lib/i18n.js",
        "lib/core.js",
        "lib/api.js",
        "lib/ui.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16x16.png",
      "32": "icons/icon-32x32.png",
      "48": "icons/icon-48x48.png",
      "128": "icons/icon-128x128.png"
    }
  }
}
